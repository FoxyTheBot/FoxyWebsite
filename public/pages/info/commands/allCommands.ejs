<!DOCTYPE html>
<html>

<head>
  <link rel="canonical" href="https://foxybot.xyz/">
  <title>Foxy | Comandos</title>
  <link rel="stylesheet" href="/styles/header.css">
  <link rel="stylesheet" href="/styles/readonly.css">
  <link rel="stylesheet" href="/styles/footer.css">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"></script>
  <link rel="icon" href="/assets/images/foxycake.png">
</head>

<body>
  <%- include('../../global/header') %>

  <script>
    const translations = {
      pt: {
        actions: "Roleplay",
        entertainment: "Diversão",
        games: "Jogos",
        economy: "Economia",
        magic: "Mágica",
        noCategory: "Sem Categoria",
        social: "Social",
        utils: "Utilitários"
      },
      en: {
        actions: "Roleplay",
        entertainment: "Entertainment",
        games: "Games",
        economy: "Economy",
        magic: "Magic",
        noCategory: "No Category",
        social: "Social",
        utils: "Utilities"
      }
    };

    function translate(categoryId, lang) {
      const langTranslations = translations[lang] || translations['en'];
      return langTranslations[categoryId] || categoryId;
    }
  </script>

  <main class="commands-page">
    <h1 class="commands-title">Comandos</h1>

    <div style="display: flex; justify-content: center; margin: 20px 0;">
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649" crossorigin="anonymous"></script>
      <ins class="adsbygoogle" style="display:inline-block;width:500px;height:100px"
        data-ad-client="ca-pub-7726590371480649" data-ad-slot="1499611127"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <% const categories = [...new Set(allCommands.map(c => c.category || 'noCategory'))]
          .filter(c => c !== 'dev'); 
       const lang = 'pt'; 
    %>

    <% categories.forEach(category => { %>
      <div class="command-category">
        <h2 class="command-category-name">
          <script>document.write(translate('<%= category %>', '<%= lang %>'));</script>
        </h2>
        <div id="wrapper-<%= category %>" class="command-wrapper">
          <table>
            <tr>
              <th>Comando</th>
              <th>Uso</th>
              <th>Prefixo</th>
            </tr>
            <% allCommands
              .filter(cmd => (cmd.category || 'noCategory') === category && !cmd.name.includes(' '))
              .forEach(command => { %>
              <tr>
                <td>/<%= command.name %></td>
                <td><%= command.usage || '/' + command.name %></td>
                <td><%= command.supportsLegacy ? 'Sim' : 'Não' %></td>
              </tr>

              <% if (command.subCommands?.length) { %>
                <tr>
                  <td colspan="4">
                    <ul style="padding-left: 20px; margin: 5px 0;">
                      <% command.subCommands.forEach(sub => { %>
                        <li>
                          <strong>/<%= command.name %> <%= sub.name %></strong> 
                          <% if (sub.supportsLegacy) { %> <em>(Suporta prefixo)</em> <% } %>
                        </li>
                      <% }) %>
                    </ul>
                  </td>
                </tr>
              <% } %>
            <% }); %>
          </table>
        </div>
      </div>
    <% }); %>
  </main>

  <%- include('./commandSidebar') %>
</body>

<script src="../js/HeaderMobile.js"></script>

</html>
