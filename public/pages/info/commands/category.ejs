<%
  const translations = {
    pt: {
      actions: "Roleplay",
      entertainment: "Diversão",
      games: "Jogos",
      economy: "Economia",
      magic: "Mágica",
      noCategory: "Sem Categoria",
      social: "Social",
      utils: "Utilitários"
    },
    en: {
      actions: "Roleplay",
      entertainment: "Entertainment",
      games: "Games",
      economy: "Economy",
      magic: "Magic",
      noCategory: "No Category",
      social: "Social",
      utils: "Utilities"
    }
  };

  const lang = 'pt'; // pode ser dinâmico se quiser
  const translatedCategory = (translations[lang] && translations[lang][category]) || category;
%>

<!DOCTYPE html>
<html>

<head>
  <link rel="canonical" href="https://foxybot.xyz/">
  <title>Foxy | Comandos de <%= translatedCategory %></title>
  <link rel="stylesheet" href="/styles/header.css">
  <link rel="stylesheet" href="/styles/readonly.css">
  <link rel="stylesheet" href="/styles/footer.css">
  <script async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"></script>
  <link rel="icon" href="/assets/images/foxycake.png">
</head>

<body>
  <%- include('../../global/header') %>

  <main>
    <h1 class="commands-title"><%= translatedCategory %></h1>

    <div style="display: flex; justify-content: center; margin: 20px 0;">
      <script async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
        crossorigin="anonymous"></script>
      <ins class="adsbygoogle" style="display:inline-block;width:500px;height:100px"
        data-ad-client="ca-pub-7726590371480649" data-ad-slot="1499611127"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <div class="command-section">
      <table class="command-table">
        <tr>
          <th>Comando</th>
          <th>Uso</th>
          <th>Suporta prefixo</th>
        </tr>
        <% commands.filter(command => !command.name.includes(' ')).forEach(command => { %>
          <tr>
            <td>/ <%= command.name %></td>
            <td><%= command.usage || '/' + command.name %></td>
            <td><%= command.supportsLegacy ? 'Sim' : 'Não' %></td>
          </tr>
          <% if (command.subCommands?.length) { %>
            <tr>
              <td colspan="3">
                <ul style="padding-left: 20px; margin: 5px 0;">
                  <% command.subCommands.forEach(sub => { %>
                    <li>
                      / <%= command.name %> <%= sub.name %>
                      <% if (sub.supportsLegacy) { %> <em>(Suporta prefixo)</em> <% } %>
                    </li>
                  <% }) %>
                </ul>
              </td>
            </tr>
          <% } %>
        <% }); %>
      </table>
    </div>

    <% const contextCommands = commands.filter(command => command.name.includes(' ')); %>
    <% if (contextCommands.length > 0) { %>
      <div class="command-section">
        <h2 class="command-category-name">Comandos de Contexto</h2>
        <table class="command-table">
          <tr>
            <th>Comando</th>
            <th>Uso</th>
          </tr>
          <% contextCommands.forEach(command => { %>
            <tr>
              <td><%= command.name %></td>
              <td><%= command.usage || command.name %></td>
            </tr>
          <% }); %>
        </table>
      </div>
    <% } %>

    <%- include("commandSidebar.ejs"); %>
  </main>
</body>

<script src="../js/HeaderMobile.js"></script>

</html>
