<head>
  <link rel="canonical" href="https://foxybot.xyz/">
  <link rel="stylesheet" href="/styles/sidebar.css">
</head>

<div class="left-sidebar">
  <div class="entries">
    <h2 class="section-title">Categoria</h2>
    <a href="/br/commands">
      <div class="entry">
        Todos (<%= allCommands.length %>)
      </div>
    </a>
    <% 
      const translations = {
        pt: {
          actions: "Roleplay",
          entertainment: "Diversão",
          games: "Jogos",
          economy: "Economia",
          magic: "Mágica",
          noCategory: "Sem Categoria",
          social: "Social",
          utils: "Utilitários"
        },
        en: {
          actions: "Roleplay",
          entertainment: "Entertainment",
          games: "Games",
          economy: "Economy",
          magic: "Magic",
          noCategory: "No Category",
          social: "Social",
          utils: "Utilities"
        }
      };

      function translate(categoryId, lang) {
        const langTranslations = translations[lang] || translations['en'];
        return langTranslations[categoryId] || categoryId;
      }

      const lang = 'pt';

      const commandsByCategory = allCommands.reduce((acc, command) => {
        const category = command.category || 'noCategory';
        if (category === 'dev' || category === 'noCategory') return acc;
        if (!acc[category]) acc[category] = [];
        acc[category].push(command);
        return acc;
      }, {});
    %>

    <% Object.keys(commandsByCategory).forEach(categoryId => { %>
      <a href="/br/commands/<%= categoryId %>">
        <div class="entry">
          <%= translate(categoryId, lang) %> (<%= commandsByCategory[categoryId].length %>)
        </div>
      </a>
    <% }); %>
  </div>
</div>