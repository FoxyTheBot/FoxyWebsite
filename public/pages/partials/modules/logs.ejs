<head>
  <link rel="canonical" href="https://foxybot.xyz/">

    <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
</head>

<h1 class="cirno-card-title">Alterações recentes:</h1>
<div class="checkouts-container" id="checkoutsContainer">

    <div class="cirno-card-container">
        <% logs.reverse().forEach(log=> { %>
            <div class="cirno-card">
                <img class="cirno-card-image avatar" src="<%= log.avatar %>" alt="Avatar">
                <div class="cirno-card-info has-avatar">
                    <h2 class="cirno-card-name big-name">
                        <%= log.actionType %>
                    </h2>
                    <h4 class="cirno-card-details">Autor: <%= log.author %> / <%= log.authorId %>
                    </h4>
                    <h4 class="cirno-card-details">Horário: <%= new Date(log.date).toLocaleString() %>
                    </h4>
                </div>
            </div>
            <% }) %>
    </div>
</div>