<div class="servers">
    <% guilds.forEach(guild=> { %>
        <div class="server">
            <div class="server__icon">
                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png"
                    alt="<%= guild.name %>" onerror="this.src='/assets/icons/noicon.png'">
            </div>
            <div class="server__info">
                <h1>
                    <%= guild.name %>
                </h1>
            </div>
            <div class="server__buttons">
                <a href="/br/servers/<%= guild.id %>/general" class="server__button">Gerenciar</a>
            </div>
        </div>
        <% }) %>
</div>