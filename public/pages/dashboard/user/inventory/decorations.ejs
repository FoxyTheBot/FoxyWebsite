<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <link rel="canonical" href="https://foxybot.xyz/">

  <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
    crossorigin="anonymous"></script>
  <link rel="stylesheet" href="/styles/header.css" type="text/css">
  <link rel="icon" href="/assets/images/foxycake.png">
  <title>Foxy | Suas decorações</title>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E3J7N4BP8L"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-E3J7N4BP8L');
  </script>
</head>
<body>
  <div class="ad vertical">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
      crossorigin="anonymous"></script>
    <ins id="adBanner" class="adsbygoogle" style="display:inline-block;width:160px;height:600px"
      data-ad-client="ca-pub-7726590371480649" data-ad-slot="4619028248"></ins>
    <script>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>

  <%- include('../../sidebar') %>

  <% if (userDecorations && userDecorations.length > 0) { %>
    <main>
      <div class="itens decorations" id="inventory">

        <div class="item <%= currentDecoration === null ? 'disabled' : '' %>"
          onclick="window.location.href='/br/decorations/change/none'">
          <div class="item__icon">
            <img class="background" src="/assets/images/none.png" />
          </div>
          <% if (!currentDecoration) { %>
            <span class="purchased">Selecionado</span>
          <% } %>
        </div>

        <% userDecorations.forEach(decoration => { 
            const isDisabled = currentDecoration === decoration.id;
        %>
          <div class="item <%= isDisabled ? 'disabled' : '' %>" 
            <%= !isDisabled ? `onclick="change('${decoration.id}')"` : '' %>>
            <div class="item__icon">
              <img class="background" src="https://stuff.foxybot.xyz/decorations/<%= decoration.filename %>" />
            </div>
            <% if (isDisabled) { %>
              <span class="purchased">Selecionado</span>
            <% } %>
          </div>
        <% }); %>

      </div>
    </main>
  <% } else { %>
    <div class="empty">
      <img class="empty-img" src="/assets/emojis/foxy_cry.png" alt="Empty" />
      <p>Você não tem decorações de avatar.<br>Compre na lojinha da Foxy usando Cakes</p>
    </div>
  <% } %>
</body>


<script>
  function change(backgroundId) {
    window.location.href = "/br/decorations/change/" + backgroundId;
  }
</script>

<script src="../js/HeaderMobile.js"></script>

</html>