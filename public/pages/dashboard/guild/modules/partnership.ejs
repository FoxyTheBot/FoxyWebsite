        <DOCTYPE html>
            <html>

            <head>
                <link rel="canonical" href="https://foxybot.win/">

                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
                <link rel="stylesheet" href="/styles/loading.css" type="text/css">
                <link rel="stylesheet" href="/styles/header.css" type="text/css">
                <link rel="icon" href="/assets/images/foxycake.png">
                <title>Foxy | Painel de Controle</title>

                <!-- Google Ads -->
                <script async
                    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
                    crossorigin="anonymous"></script>

                <!-- Google Analytics -->

                <script async src="https://www.googletagmanager.com/gtag/js?id=G-E3J7N4BP8L"></script>
                <script>
                    window.dataLayer = window.dataLayer || [];
                    function gtag() { dataLayer.push(arguments); }
                    gtag('js', new Date());
                    gtag('config', 'G-E3J7N4BP8L');
                </script>
                <script src="https://unpkg.com/htmx.org"></script>
            </head>

            <body>
                <%- include('../sidebar') %>
                    <div class="config-wrapper">

                        <h1 class="module-title">Gerenciar Parceria</h1>
                        <p class="module-description">Configurações relacionadas a parceria entre a Foxy e outros
                            servidores!
                            <br><br>
                            Entre no no nosso servidor de suporte para acompanhar as novidades para servidores
                            parceiros!
                        </p>

                        <div class="config-module-wrapper">
                            <form action="/api/v1/servers/<%= guildId %>/partnership" method="POST"
                                class="config-module-form">

                                <div class="config-module">
                                    <label class="module-name">Dar o premium recomendado caso o servidor seja
                                        impulsionado</label>
                                    <label class="switch">
                                        <input type="checkbox" id="isPremiumIfBoostedEnabled"
                                            name="isPremiumIfBoostedEnabled">
                                        <span class="slider round"></span>
                                    </label>
                                </div>


                                <div class="config-module">
                                    <label class="module-name">Notificar um usuário quando ele receber o premium</label>
                                    <label class="switch">
                                        <input type="checkbox" id="notifyUserOnPremium" name="notifyUserOnPremium">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="config-module">
                                    <label class="module-name">Convite do servidor</label>
                                    <div class="text-area" style="display: flex; align-items: center;">
                                        <input type="text" name="serverInvite" id="serverInvite"
                                            placeholder="Convite do servidor" maxlength="200" minlength="1" required
                                            style="width: 120%">
                                    </div>
                                </div>

                                <div class="config-module">
                                    <label class="module-name">Canal onde pode ser resgatado</label>
                                    <div class="channel-selector" style="display: flex; align-items: center;">
                                        <select name="redeemChannel" id="redeemChannel" style="width: 100%">
                                            <option value="" disabled selected>Selecione um canal</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="actions-wrapper">
                                    <h3 class="save-message">Clique em salvar para aplicar as alterações</h3>
                                    <div class="actions">
                                        <button id="saveButton" type="submit">Salvar</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div id="loadingOverlay" class="loading-overlay">
                        <%- include('../../../global/loading') %>
                    </div>

                    <script type="module">
                        import { showActionsWrapper } from '/js/moduleHasChanges.js'

                        window.addEventListener('load', async function () {
                            const loadingOverlay = document.getElementById('loadingOverlay');
                            const isPremiumIfBoostedEnabled = document.getElementById('isPremiumIfBoostedEnabled');
                            const notifyUserOnPremium = document.getElementById('notifyUserOnPremium');
                            const redeemChannel = document.getElementById('redeemChannel');
                            const serverInvite = document.getElementById('serverInvite');

                            const saveButton = document.getElementById('saveButton');

                            saveButton.addEventListener('click', function () {
                                loadingOverlay.classList.remove('hidden');
                            });

                            let blockedChannelsArray = [];

                            try {
                                const response = await fetch('/api/v1/servers/<%= guildId %>/data');
                                const data = await response.json();

                                isPremiumIfBoostedEnabled.checked = data.foxyVerseGuild.serverBenefits.givePremiumIfBoosted.isEnabled;
                                notifyUserOnPremium.checked = data.foxyVerseGuild.serverBenefits.givePremiumIfBoosted.notifyUser;
                                serverInvite.value = data.foxyVerseGuild.serverInvite;

                                const channelsResponse = await fetch(`/api/v1/servers/<%= guildId %>/channels`);
                                const channelsData = await channelsResponse.json();

                                channelsData.channels.forEach(channel => {
                                    const channelOption = document.createElement('option');
                                    channelOption.value = channel.id;
                                    channelOption.textContent = channel.name;
                                    redeemChannel.appendChild(channelOption.cloneNode(true));
                                })
                                redeemChannel.value = data.foxyVerseGuild.serverBenefits.givePremiumIfBoosted.textChannelToRedeem;


                            } catch (error) {
                                console.error('Error fetching data:', error);
                            } finally {
                                loadingOverlay.classList.add('hidden');
                            }
                        });
                    </script>
            </body>

            </html>