</head>

<body>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
        crossorigin="anonymous"></script>
    <ins id="adBanner" class="adsbygoogle" style="display:inline-block;width:160px;height:600px"
        data-ad-client="ca-pub-7726590371480649" data-ad-slot="4619028248"></ins>
    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>

    <%- include('../sidebar') %>

        <div class="config-wrapper">
            <h1 class="module-title">Configurações gerais</h1>
            <p class="module-description">Olá, obrigada por me adicionar no seu servidor! Aqui estão algumas
                configurações básicas para você me configurar como quiser!</p>

            <div class="config-module-wrapper">
                <form action="/br/servers/<%= guildId %>/modules/general" method="POST" class="config-module-form">
                    <div class="config-module">
                        <label class="module-name">Prefixo da Foxy</label>
                        <div>
                            <input type="text" name="botPrefix" id="botPrefix" placeholder="Prefixo" maxlength="10"
                                minlength="1" required style="width: 50%">
                        </div>
                    </div>

                    <div class="config-module">
                        <label class="module-name">Deletar mensagem quando um comando foi enviado</label>
                        <label class="switch">
                            <input type="checkbox" id="deleteMessageIfCommandIsExecuted"
                                name="deleteMessageIfCommandIsExecuted">
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="config-module">
                        <label class="module-name">Canais onde comandos não podem ser executados</label>
                        <div class="channel-selector" style="display: flex; align-items: center;">
                            <select name="channelsToBlockCommands" id="channelsToBlockCommands" style="width: 60%">
                                <option value="" disabled selected>Selecione um canal</option>
                            </select>
                            <button id="addChannelButton" type="button">Adicionar</button>
                        </div>
                        <div id="selectedChannels" class="selected-channels"></div>
                    </div>
                    <button id="saveButton" type="submit">Salvar</button>
                </form>
            </div>
        </div>
        <div id="loadingOverlay" class="loading-overlay">
            <%- include('../../../global/loading') %>
        </div>
        <script>
            window.addEventListener('load', async function () {
                const loadingOverlay = document.getElementById('loadingOverlay');
                const botPrefix = document.getElementById('botPrefix');
                const deleteMessageIfCommandIsExecuted = document.getElementById('deleteMessageIfCommandIsExecuted');
                const channelsToBlockCommandsSelect = document.getElementById('channelsToBlockCommands');
                const saveButton = document.getElementById('saveButton');

                saveButton.addEventListener('click', function() {
                    loadingOverlay.classList.remove('hidden');
                });

                let blockedChannelsArray = [];

                try {
                    const response = await fetch('/br/servers/<%= guildId %>/data');
                    const data = await response.json();

                    botPrefix.value = data.guildSettings.prefix;
                    deleteMessageIfCommandIsExecuted.checked = data.guildSettings.deleteMessageIfCommandIsExecuted;
                    const channelsResponse = await fetch(`/br/servers/<%= guildId %>/channels`);
                    const channelsData = await channelsResponse.json();

                    channelsData.channels.forEach(channel => {
                        const channelOption = document.createElement('option');
                        channelOption.value = channel.id;
                        channelOption.textContent = channel.name;
                        channelsToBlockCommandsSelect.appendChild(channelOption);
                    });

                    const blockedChannels = data.guildSettings.blockedChannels || [];
                    blockedChannelsArray = [...blockedChannels];
                    blockedChannels.forEach(blockedChannelId => {
                        const option = channelsToBlockCommandsSelect.querySelector(`option[value="${blockedChannelId}"]`);
                        if (option) addChannelDisplay(blockedChannelId, option.textContent);
                    });

                    document.getElementById('addChannelButton').addEventListener('click', function () {
                        const select = document.getElementById('channelsToBlockCommands');
                        const selectedChannelId = select.value;
                        const selectedChannelText = select.options[select.selectedIndex].text;

                        if (selectedChannelId && !document.getElementById(`channel-${selectedChannelId}`)) {
                            blockedChannelsArray.push(selectedChannelId);
                            addChannelDisplay(selectedChannelId, selectedChannelText);
                        }
                    });

                    function addChannelDisplay(channelId, channelName) {
                        const channelDisplay = document.createElement('span');
                        channelDisplay.className = 'channel-mention';
                        channelDisplay.id = `channel-${channelId}`;
                        channelDisplay.innerHTML = `#${channelName}`;

                        const removeBtn = document.createElement('button');
                        removeBtn.innerText = 'Remover';
                        removeBtn.onclick = function () {
                            document.getElementById('selectedChannels').removeChild(channelDisplay);
                            blockedChannelsArray = blockedChannelsArray.filter(id => id !== channelId);
                        };

                        channelDisplay.appendChild(removeBtn);
                        document.getElementById('selectedChannels').appendChild(channelDisplay);
                    }

                    document.querySelector('.config-module-form').addEventListener('submit', function (e) {
                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'blockedChannels';
                        hiddenInput.value = JSON.stringify(blockedChannelsArray);
                        this.appendChild(hiddenInput);
                    });

                } catch (error) {
                    console.error('Error fetching data:', error);
                } finally {
                    loadingOverlay.classList.add('hidden');
                }
            });
        </script>
</body>
<script src="/js/theme.js"></script>

</html>