<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
    <link rel="stylesheet" href="/styles/loading.css" type="text/css">
    <link rel="stylesheet" href="/styles/header.css" type="text/css">
    <link rel="icon" href="/assets/images/foxycake.png">
    <title>Foxy | Painel de Controle</title>

    <!-- Google Ads -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
        crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E3J7N4BP8L"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-E3J7N4BP8L');
    </script>
</head>

<body>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
        crossorigin="anonymous"></script>
    <ins id="adBanner" class="adsbygoogle" style="display:inline-block;width:160px;height:600px"
        data-ad-client="ca-pub-7726590371480649" data-ad-slot="4619028248"></ins>
    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>

    <%- include('../sidebar') %>

        <div class="config-wrapper">
            <h1 class="module-title">Configurações gerais</h1>
            <p class="module-description">Olá, obrigada por me adicionar no seu servidor! Aqui estão algumas
                configurações básicas para você me configurar como quiser!</p>

            <div class="config-module-wrapper">
                <form action="/br/servers/<%= guildId %>/modules/general" method="POST" class="config-module-form">
                    <div class="config-module">
                        <label class="module-name">Prefixo da Foxy</label>
                        <div>
                            <input type="text" name="botPrefix" id="botPrefix" placeholder="Prefixo" maxlength="3" ,
                                minlength="1">
                        </div>
                    </div>

                    <div class="config-module">
                        <label class="module-name">Deletar mensagem quando um comando foi enviado</label>
                        <label class="switch">
                            <input type="checkbox" id="deleteMessageIfCommandIsExecuted"
                                name="deleteMessageIfCommandIsExecuted">
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <button id="saveButton" type="submit">Salvar</button>
                </form>
            </div>
        </div>
        <div id="loadingOverlay" class="loading-overlay">
            <%- include('../../../global/loading') %>
        </div>
        <script>
            window.addEventListener('load', async function () {
                const loadingOverlay = document.getElementById('loadingOverlay');
                const botPrefix = document.getElementById('botPrefix');
                const deleteMessageIfCommandIsExecuted = document.getElementById('deleteMessageIfCommandIsExecuted');

                try {
                    const response = await fetch('/br/servers/<%= guildId %>/data');
                    const data = await response.json();
                    
                    botPrefix.value = data.guildSettings.prefix;
                    deleteMessageIfCommandIsExecuted.checked = data.guildSettings.deleteMessageIfCommandIsExecuted;

                } catch (error) {
                    console.error('Error fetching data:', error);
                } finally {
                    loadingOverlay.classList.add('hidden');
                }
            });
        </script>
</body>
<script src="/js/theme.js"></script>

</html>