<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <link rel="canonical" href="https://foxybot.xyz/">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
    <link rel="stylesheet" href="/styles/loading.css" type="text/css">
    <link rel="stylesheet" href="/styles/header.css" type="text/css">
    <link rel="icon" href="/assets/images/foxycake.png">
    <title>Foxy | Painel de Controle</title>

    <!-- Google Ads -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
        crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E3J7N4BP8L"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-E3J7N4BP8L');
    </script>
    <script src="/js/moduleHasChanges.js" defer type="module"></script>
    <script src="/js/jsonImport/importJson.js" defer type="module"></script>
    <script src="/js/popupHandler.js" defer type="module"></script>
    <script src="/js/updateBotImage.js" defer type="module"></script>
    <script src="/js/welcomerImageVerify.js" defer type="module"></script>
</head>

<body>
    <div class="ad vertical">
        <script async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
            crossorigin="anonymous"></script>
        <ins id="adBanner" class="adsbygoogle" style="display:inline-block;width:160px;height:600px"
            data-ad-client="ca-pub-7726590371480649" data-ad-slot="4619028248">
        </ins>
        <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>
    <%- include('../sidebar') %>
        <div id="popup" class="popup-wrapper hidden">
            <div class="popup">
                <div class="content">
                    <h2 class="title">Importar JSON</h2>
                    <p class="description" style="text-align: center;">Importe embeds em JSON de outros bots para
                        funcionar com a Foxy!
                        <br><br>Campos incompatíveis serão removidos durante a importação.
                    </p>
                </div>
                <form id="importForm" style="width: 100%;" data-gtm-form-interact-id="0">
                    <div class="form-content">
                        <input type="hidden" name="backgroundId" id="backgroundId">

                        <div class="form-group" style="display: flex;align-items: center;gap: 51%;width: 100%;">
                            <div>
                                <label for="botSelect">Selecione o bot:</label>
                                <select id="botSelect" name="botSelect" required="" onchange="updateBotImage()"
                                    style="width: 250%;" data-gtm-form-interact-field-id="0">
                                    <option value="" disabled="" selected="">Escolha um bot</option>
                                    <option value="loritta">Loritta</option>
                                    <option value="carl-bot">Carl Bot</option>
                                </select>
                            </div>

                            <div id="botImageContainer" style="text-align: center;">
                                <img id="botImage" src="https://cdn.discordapp.com/embed/avatars/0.png"
                                    style="max-width: 85px;display: block;border-radius: 50%;">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="jsonInput">Cole o JSON:</label>
                            <textarea id="jsonInput" name="jsonInput" rows="8" placeholder="Cole o JSON aqui..."
                                required=""></textarea>
                        </div>
                    </div>
                    <div class="popup-buttons">
                        <button type="button" id="cancel" onclick="hidePopup()"
                            class="popup-button cancel">Fechar</button>
                        <button type="button" id="import" class="popup-button">Importar</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="config-wrapper">
            <h1 class="module-title">Mensagens de Entrada/Saída</h1>
            <p class="module-description">Configure a Foxy para notificar quando um membro entra ou sai do seu servidor!
            </p>
            <div class="config-module-wrapper">
                <form action="/api/v1/servers/<%= guildId %>/modules/welcomer" method="POST" class="config-module-form">
                    <div class="config-module">
                        <label class="module-name">Enviar mensagem quando alguém entrar no servidor</label>
                        <label class="switch">
                            <input type="checkbox" id="toggleWelcomeModule" name="toggleWelcomeModule">
                            <span class="slider round"></span>
                        </label>

                        <div class="toggleable-options hidden" id="toggleableWelcomeOptions">
                            <div class="toggleable-option">
                                <label class="toggleable-option-title">Selecione um canal de boas-vindas</label>
                                <select name="welcomeChannel" id="welcomeChannel">
                                </select>
                            </div>

                            <div class="toggleable-option">
                                <label class="module-name">Mensagem de boas-vindas</label>
                                <div class="button-wrapper">
                                    <button id="welcomeTestButton" type="button">Testar Mensagem</button>
                                    <button type="button" onclick="showPopup()" data-module-type="welcome">Importar
                                        JSON</button>
                                </div>
                                <br>
                                <div>
                                    <label class="toggleable-option-title">Conteúdo da mensagem</label>
                                    <input type="text" name="messageContent" id="message" placeholder="Conteúdo da mensagem">
                                </div>
                                <div class="toggleable-option embed-config">
                                    <label class="module-name">Configurar Embed</label>
                                    <br><br>
                                    <div>
                                        <label class="toggleable-option-title">Título do Embed</label>
                                        <input type="text" name="embedTitle" id="embedTitle"
                                            placeholder="Título do embed">
                                    </div>
                                    <div>
                                        <label class="toggleable-option-title">Descrição do Embed</label>
                                        <textarea name="embedDescription" id="embedDescription" rows="10" cols="50"
                                            placeholder="Descrição do embed"></textarea>
                                    </div>
                                    <div>
                                        <label class="toggleable-option-title">Imagem (link)</label>
                                        <input type="text" name="imageLink" id="imageLink" placeholder="Link da imagem">
                                    </div>
                                    <div>
                                        <label class="toggleable-option-title">Footer</label>
                                        <input type="text" name="embedFooter" id="embedFooter"
                                            placeholder="Footer da embed">
                                    </div>
                                    <div>
                                        <label class="toggleable-option-title">Cor do Embed</label>
                                        <input type="color" name="embedColor" id="embedColor" value="#ffffff"
                                            class="embedColor">
                                    </div>
                                    <div>
                                        <label class="toggleable-option-title">Mostrar avatar do usuário</label>
                                        <label class="switch small">
                                            <input type="checkbox" name="welcomeShowAvatar" id="showAvatar">
                                            <span class="slider round"></span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="config-module">
                        <label class="module-name">Enviar mensagem quando alguém sair do servidor</label>
                        <label class="switch">
                            <input type="checkbox" id="toggleGoodbyeModule" name="toggleGoodbyeModule">
                            <span class="slider round"></span>
                        </label>
                        <div class="toggleable-options hidden" id="toggleableGoodbyeOptions">
                            <div class="toggleable-option">
                                <label class="toggleable-option-title">Canal de despedidas</label>
                                <select name="goodbyeChannel" id="goodbyeChannel">
                                    <option value="" disabled selected>Selecione um canal</option>
                                </select>
                                <label class="toggleable-option-title">Mensagem de despedida</label>
                                <div class="button-wrapper">
                                    <button id="goodbyeTestButton" type="button">Testar Mensagem</button>
                                    <button type="button" onclick="showPopup()" data-module-type="goodbye">Importar
                                        JSON</button>
                                </div>
                                <input type="text" name="goodbyeMessage" id="goodbyeMessage"
                                    placeholder="Mensagem de despedida">

                                <div class="toggleable-option embed-config">
                                    <label class="module-name">Configurar Embed</label>
                                    <br><br>
                                    <label class="toggleable-option-title">Título do Embed</label>
                                    <input type="text" name="goodbyeEmbedTitle" id="goodbyeEmbedTitle"
                                        placeholder="Título do embed">

                                    <label class="toggleable-option-title">Descrição do Embed</label>
                                    <textarea name="goodbyeEmbedDescription" id="goodbyeEmbedDescription" rows="10"
                                        cols="50" placeholder="Descrição do embed"></textarea>

                                    <label class="toggleable-option-title">Imagem (link)</label>
                                    <input type="text" name="goodbyeImageLink" id="goodbyeImageLink"
                                        placeholder="Link da imagem">

                                    <label class="toggleable-option-title">Footer</label>
                                    <input type="text" name="goodbyeEmbedFooter" id="goodbyeEmbedFooter"
                                        placeholder="Footer da embed">

                                    <label class="toggleable-option-title">Cor do Embed</label>
                                    <input type="color" name="goodbyeEmbedColor" id="goodbyeEmbedColor" value="#ffffff"
                                        class="embedColor">

                                    <label class="toggleable-option-title">Mostrar avatar do usuário</label>
                                    <label class="switch small">
                                        <input type="checkbox" name="goodbyeShowAvatar" id="goodbyeShowAvatar">
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="actions-wrapper">
                        <h3 class="save-message">Clique em salvar para aplicar as alterações</h3>
                        <div class="actions">
                            <button id="saveButton" type="submit">Salvar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="loadingOverlay" class="loading-overlay">
            <%- include('../../../global/loading') %>
        </div>

        <div id="notification" class="notification"></div>

        <script>
            const imageLinkRegex = /https?:\/\/.*\.(?:png|jpg|jpeg|gif|webp)/;
            const saveButton = document.getElementById("saveButton");
            const testButtons = document.querySelectorAll(".test-btn");
            const loadingOverlay = document.getElementById('loadingOverlay');

            document.getElementById("goodbyeTestButton").addEventListener("click", async function () {
                const form = document.querySelector(".config-module-form");
                const originalAction = form.action;
                const guildId = "<%= guildId %>";
                const testAction = `/api/v1/servers/${guildId}/modules/welcomer/test/module/goodbyeModule`;

                const formData = new FormData(form);

                if (!imageLinkRegex.test(formData.get('goodbyeImageLink')) && formData.get('goodbyeImageLink')) {
                    const imageLink = document.getElementById('goodbyeImageLink');
                    imageLink.style.border = '2px solid red';
                    imageLink.classList.add('shake');

                    setTimeout(() => {
                        imageLink.classList.remove('shake');
                    }, 500);

                    return;
                }

                const data = Object.fromEntries(formData.entries());
                saveButton.disabled = true;
                loadingOverlay.classList.remove('hidden');
                testButtons.forEach(button => button.disabled = true);

                try {
                    const response = await fetch(testAction, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(data)
                    });

                    if (!response.ok) throw new Error(`Erro: ${response.statusText}`);
                    saveButton.disabled = false;
                    loadingOverlay.classList.add('hidden');
                    testButtons.forEach(button => button.disabled = false);

                } catch (error) {
                    alert(`Erro ao testar: ${error.message}`);
                    saveButton.disabled = false;
                    loadingOverlay.classList.add('hidden');
                    testButtons.forEach(button => button.disabled = false);
                } finally {
                    form.action = originalAction;
                }
            });

            document.getElementById("welcomeTestButton").addEventListener("click", async function () {
                const form = document.querySelector(".config-module-form");
                const originalAction = form.action;
                const guildId = "<%= guildId %>";
                const testAction = `/api/v1/servers/${guildId}/modules/welcomer/test/module/welcomeModule`;

                const formData = new FormData(form);
                if (!imageLinkRegex.test(formData.get('imageLink')) && formData.get('imageLink')) {
                    const imageLink = document.getElementById('imageLink');
                    imageLink.style.border = '2px solid red';
                    imageLink.classList.add('shake');

                    setTimeout(() => {
                        imageLink.classList.remove('shake');
                    }, 500);

                    return;
                }

                const data = Object.fromEntries(formData.entries());
                saveButton.disabled = true;
                loadingOverlay.classList.remove('hidden');
                testButtons.forEach(button => button.disabled = true);

                try {
                    const response = await fetch(testAction, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(data)
                    });
                    if (!response.ok) throw new Error(`Erro: ${response.statusText}`);
                    saveButton.disabled = false;
                    loadingOverlay.classList.add('hidden');
                    testButtons.forEach(button => button.disabled = false);
                } catch (error) {
                    alert(`Erro ao testar: ${error.message}`);
                    saveButton.disabled = false;
                    loadingOverlay.classList.add('hidden');
                    testButtons.forEach(button => button.disabled = false);
                } finally {
                    form.action = originalAction;
                }
            });

            window.addEventListener('load', async function () {
                const toggleWelcomeModule = document.getElementById('toggleWelcomeModule');
                const toggleGoodbyeModule = document.getElementById('toggleGoodbyeModule');
                const toggleableWelcomeOptions = document.getElementById('toggleableWelcomeOptions');
                const toggleableGoodbyeOptions = document.getElementById('toggleableGoodbyeOptions');
                const welcomeChannelSelect = document.getElementById('welcomeChannel');
                const goodbyeChannelSelect = document.getElementById('goodbyeChannel');
                const goodbyeEmbedColor = document.getElementById('goodbyeEmbedColor');
                const welcomeEmbedColor = document.getElementById('embedColor');
                const welcomeShowAvatar = document.getElementById('showAvatar');
                const goodbyeShowAvatar = document.getElementById('goodbyeShowAvatar');
                const saveButton = document.getElementById('saveButton');

                saveButton.addEventListener('click', function () {
                    loadingOverlay.classList.remove('hidden');
                });

                try {
                    const response = await fetch('/api/v1/servers/<%= guildId %>/data');
                    const data = await response.json();

                    toggleWelcomeModule.checked = data.GuildJoinLeaveModule.isEnabled || false;
                    toggleGoodbyeModule.checked = data.GuildJoinLeaveModule.alertWhenUserLeaves || false;

                    toggleableWelcomeOptions.classList.toggle('hidden', !toggleWelcomeModule.checked);
                    toggleableGoodbyeOptions.classList.toggle('hidden', !toggleGoodbyeModule.checked);

                    toggleWelcomeModule.addEventListener('change', function () {
                        toggleableWelcomeOptions.classList.toggle('hidden', !toggleWelcomeModule.checked);
                    });

                    toggleGoodbyeModule.addEventListener('change', function () {
                        toggleableGoodbyeOptions.classList.toggle('hidden', !toggleGoodbyeModule.checked);
                    });

                    const joinMessage = JSON.parse(data.GuildJoinLeaveModule.joinMessage || '{}');
                    const leaveMessage = JSON.parse(data.GuildJoinLeaveModule.leaveMessage || '{}');

                    if (joinMessage.embeds) {
                        document.querySelector('#message').value = joinMessage.content || '';
                        document.querySelector('#embedTitle').value = joinMessage.embeds[0]?.title || '';
                        document.querySelector('#embedDescription').value = joinMessage.embeds[0]?.description || '';
                        document.querySelector('#embedFooter').value = joinMessage.embeds[0]?.footer?.text || '';
                        document.querySelector('#imageLink').value = joinMessage.embeds[0]?.image?.url || '';

                        if (joinMessage.embeds[0]?.thumbnail?.url) {
                            document.querySelector('#showAvatar').checked = true;
                        }
                        const joinColor = joinMessage.embeds[0]?.color || 0xFFFFFF;
                        document.querySelector('#embedColor').value = `#${joinColor.toString(16).padStart(6, '0')}`;
                        welcomeEmbedColor.value = `#${joinColor.toString(16).padStart(6, '0')}`;
                    }

                    if (leaveMessage.embeds) {
                        document.querySelector('#goodbyeMessage').value = leaveMessage.content || '';
                        document.querySelector('#goodbyeEmbedTitle').value = leaveMessage.embeds[0]?.title || '';
                        document.querySelector('#goodbyeEmbedDescription').value = leaveMessage.embeds[0]?.description || '';
                        document.querySelector('#goodbyeEmbedFooter').value = leaveMessage.embeds[0]?.footer?.text || '';
                        document.querySelector('#goodbyeImageLink').value = leaveMessage.embeds[0]?.image?.url || '';

                        if (leaveMessage.embeds[0]?.thumbnail?.url) {
                            document.querySelector('#goodbyeShowAvatar').checked = true;
                        }
                        const leaveColor = leaveMessage.embeds[0]?.color || 0xFFFFFF;
                        document.querySelector('#goodbyeEmbedColor').value = `#${leaveColor.toString(16).padStart(6, '0')}`;
                        goodbyeEmbedColor.value = `#${leaveColor.toString(16).padStart(6, '0')}`;
                    }

                    const channelsResponse = await fetch(`/api/v1/servers/<%= guildId %>/channels`);
                    const channelsData = await channelsResponse.json();

                    const joinChannelId = data.GuildJoinLeaveModule.joinChannel || '';
                    const leaveChannelId = data.GuildJoinLeaveModule.leaveChannel || '';

                    channelsData.channels.forEach(channel => {
                        const welcomeOption = document.createElement('option');
                        welcomeOption.value = channel.id;
                        welcomeOption.textContent = "# " + channel.name;
                        welcomeChannelSelect.appendChild(welcomeOption);
                        const goodbyeOption = document.createElement('option');
                        goodbyeOption.value = channel.id;
                        goodbyeOption.textContent = "# " + channel.name;
                        goodbyeChannelSelect.appendChild(goodbyeOption);

                        if (channel.id === joinChannelId) {
                            welcomeOption.selected = true;
                        }

                        if (channel.id === leaveChannelId) {
                            goodbyeOption.selected = true;
                        }
                    });

                    welcomeChannelSelect.value = joinChannelId || channelsData.channels[0]?.id;
                    goodbyeChannelSelect.value = leaveChannelId || channelsData.channels[0]?.id;

                } catch (error) {
                    console.error('Error fetching data:', error);
                } finally {
                    loadingOverlay.classList.add('hidden');
                }
            });
        </script>
</body>

</html>