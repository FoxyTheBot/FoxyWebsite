<head>
  <link rel="canonical" href="https://foxybot.xyz/">

    <link rel="stylesheet" href="/styles/sidebar.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
  
  </head>
  
  <!-- Sidebar -->
  <div class="left-sidebar" id="sidebar">
    <div class="entries">
      <a href="/br/dashboard"> <img src="/assets/images/logo.png" alt="Foxy" class="logo"> </a>
      <hr class="separator">
      <a href="/br/dashboard">
        <div class="entry">Voltar à lista de servidores</div>
        </a>
        <a href="/br/servers/<%= guildId %>/general">
          <div class="entry">Configurações gerais</div>
        </a>
        <% if (guildData.foxyVerseGuild) { %>
          <hr class="separator">
          <h2 class="section-title"></h2>
          <a href="/br/servers/<%= guildId %>/partnership">
            <div class="entry">Gerenciar Parceria</div>
          </a>
        <% } %>

      <hr class="separator">
      <h2 class="section-title">Módulos</h2>
      <a href="/br/servers/<%= guildId %>/welcomer">
        <div class="entry">Mensagens de Entrada/Saída</div>
      </a>

      <hr class="separator">
      <h2 class="section-title">Configurações</h2>
  
      <a href="/br/dashboard/subscriptions">
        <div class="entry">Chaves Premium</div>
      </a>
      
      <a href="/br/servers/<%= guildId %>/logs">
        <div class="entry">Registro de Auditoria</div>
      </a>

    </div>
  </div>
  
  <button class="sidebar-toggle" id="sidebar-toggle">
    <i class="fas fa-bars"></i>
  </button>
  
  
  <script>
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
  
    sidebarToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('open');
      sidebarToggle.setAttribute('aria-expanded', isOpen);
    });
  </script>