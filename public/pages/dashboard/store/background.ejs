<!DOCTYPE html>
<html>

<head>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7726590371480649"
    crossorigin="anonymous"></script>
  <link rel="stylesheet" href="/styles/header.css" type="text/css">
  <link rel="icon" href="/assets/images/foxycake.png">
  <title>Foxy | Loja</title>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E3J7N4BP8L"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-E3J7N4BP8L');
  </script>
  <link rel="stylesheet" href="/styles/dashboard.css" type="text/css">
  <link rel="stylesheet" href="/styles/loading.css" type="text/css">
</head>

<body>
  <div id="loadingOverlay" class="loading-overlay">
    <%- include('../../global/loading') %>
  </div>

  <%- include('../sidebar') %>

    <div class="ad vertical">
      <ins id="adBanner" class="adsbygoogle" style="display:inline-block;width:160px;height:600px"
        data-ad-client="ca-pub-7726590371480649" data-ad-slot="4619028248"></ins>
      <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>

    <div class="store-content">
      <h1 class="page-title"><img src="/assets/emojis/foxy_daily.png" class="inline-emoji"> Lojinha da Foxy <img
          src="/assets/emojis/foxy_daily.png" class="inline-emoji"></h1>
      <p>Deixe seu perfil mais bonito com os backgrounds e decorações de avatar super fofinhos! (◕‿◕✿)

        <br><br> Todo dia, às 00:00 UTC (21:00 Horário de Brasília), a loja é atualizada, vai que você consiga
        aquele
        background ou aquela decoração que você tanto queria?
      </p>
      <div class="remaining-time">
        <h2>Tempo restante para a próxima atualização:</h2>
        <h2 id="countdown"></h2>
        <main id="content" class="hidden">
          <!-- Content will be injected here by JavaScript -->
        </main>
      </div>

      <div id="popup" class="popup-wrapper hidden">
        <div class="popup">
          <div class="content">
            <span class="close" onclick="hidePopup()">&times;</span>
            <h2 id="bg-title" class="title"></h2>
            <img id="popup-img" src="" alt="Background Image">
            <p id="bg-description" class="description"></p>
          </div>
          <form id="purchaseForm" method="POST">
            <input type="hidden" name="backgroundId" id="backgroundId">
            <div class="popup-buttons">
              <h3>Comprar por <strong style="color: #e7385d;" id="price-in-cakes"></strong> Cakes</h3>
              <button id="save" type="submit">Comprar</button>
            </div>
          </form>
        </div>
      </div>

      <script>
        window.addEventListener('load', function () {
          fetch('/br/store/data')
            .then(response => response.json())
            .then(data => {
              document.getElementById('loadingOverlay').classList.add('hidden');
              document.getElementById('content').classList.remove('hidden');

              const contentDiv = document.getElementById('content');

              function generateItems(items, type, userList) {
                return items.reverse().map(item => {
                  if (item.cakes === 0 || item.inactive) return '';

                  const itemStr = JSON.stringify(item).replace(/"/g, '&quot;');
                  const userStr = JSON.stringify(data.user).replace(/"/g, '&quot;');
                  const userDataStr = JSON.stringify(data.userData).replace(/"/g, '&quot;');
                  const isPurchased = userList.includes(item.id);
                  const releaseDate = new Date(item.releaseDate);
                  const currentDate = new Date();
                  const diffTime = currentDate - releaseDate;
                  const isNew = diffTime < 2 * 24 * 60 * 60 * 1000;
                  let itemType;

                  switch (type) {
                    case 'backgrounds':
                      itemType = 'Fundo para Perfil';
                      break;
                    case 'decorations':
                      itemType = 'Decoração de Avatar';
                      break;
                    case 'layouts':
                      itemType = 'Design para Perfil';
                      break;
                    default:
                      itemType = 'item';
                  }

                  let rarity;

                  switch (item?.rarity?.toLowerCase()) {
                    case 'common':
                      itemType += ' (Comum)';
                      rarity = item.rarity.toLowerCase();
                      break;
                    case 'uncommon':
                      itemType += ' (Incomum)';
                      rarity = item.rarity.toLowerCase();
                      break;
                    case 'rare':
                      itemType += ' (Raro)';
                      rarity = item.rarity.toLowerCase();
                      break;
                    case 'epic':
                      itemType += ' (Épico)';
                      rarity = item.rarity.toLowerCase();
                      break;
                    case 'legendary':
                      itemType += ' (Lendário)';
                      rarity = item.rarity.toLowerCase();
                      break;
                    default:
                      itemType += '';
                  }
                  const isLimitedEdition = item.limitedEdition;

                  return `
      <div class="item ${isPurchased ? 'disabled' : ''}"
        onclick="showPopup(${itemStr}, ${userStr}, ${userDataStr})">
        <div class="item__icon">
          <img class="${type}" 
            src="https://cakey.foxybot.win/assets/${type}/${item.filename}" 
            onerror="this.src='https://cakey.foxybot.win/assets/masks/${item.filename}'" 
            alt="${item.name}">
        </div>
        <div class="item_info">
          <h1 class="item-name ${isLimitedEdition ? 'limited' : ''}">${item.name}</h1>
          <h5>${itemType}</h5>
          ${isPurchased ? `
            <span class="purchased">💖 Já comprado</span>
          ` : `
            <span class="cakes">${item.cakes.toLocaleString("pt-BR")} Cakes</span>
          `}
          ${isLimitedEdition ? `<div class="flag limited">Edição Limitada!</div>` : (isNew ? `<div class="flag">Novidade!</div>` : '')}
        </div>
      </div>
    `;
                }).join('');
              }

              const { backgrounds, decorations, layouts } = data.storeContent;

              contentDiv.innerHTML = `
  <div class="itens">
    ${generateItems(backgrounds, 'backgrounds', data.userData.userProfile.backgroundList)}
    ${generateItems(decorations, 'decorations', data.userData.userProfile.decorationList)}
    ${generateItems(layouts, 'layouts', data.userData.userProfile.layoutList)}
  </div>
`;
              startCountdown(data.lastUpdate);
            })
            .catch(error => {
              console.error('Erro ao buscar os dados:', error);
              document.getElementById('loadingOverlay').innerText =
                'Falha ao carregar o conteúdo. Tente novamente mais tarde.';
            });

        });

        function startCountdown(lastUpdate) {
          const updateHour = 21;
          const lastUpdateDate = new Date(lastUpdate);
          const now = new Date();

          let nextUpdate = new Date(lastUpdateDate);
          nextUpdate.setHours(updateHour, 0, 0, 0);

          if (now.getTime() >= nextUpdate.getTime()) {
            nextUpdate.setDate(nextUpdate.getDate() + 1);
          }

          const countdownElement = document.getElementById('countdown');

          function updateCountdown() {
            const now = new Date();
            const distance = nextUpdate - now;

            if (distance <= 0) {
              nextUpdate.setDate(nextUpdate.getDate() + 1);
              updateCountdown();
              return;
            }

            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            countdownElement.innerHTML = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
          }

          updateCountdown();
          setInterval(updateCountdown, 1000);
        }

        function preloadImage(url) {
          return new Promise((resolve) => {
            const img = new Image();
            img.onload = () => resolve(url);
            img.onerror = () => resolve("/assets/previews/error-placeholder.png");
            img.src = url;
          });
        }

        function showPopup(background, user, userData) {
          const popupImg = document.getElementById('popup-img');
          const bgTitle = document.getElementById('bg-title');
          const bgDescription = document.getElementById('bg-description');
          const saveButton = document.getElementById('save');
          const price = document.getElementById('price-in-cakes');

          let imageUrl = `https://orchid.cakeyfox.live/assets/previews/item_${background.id}.png`;
          if (background.id === "red" && background.profileSettings && typeof background.profileSettings === "object") {
            imageUrl = `https://orchid.cakeyfox.live/assets/previews/item_${background.id}_layout.png`;
          }

          document.getElementById('backgroundId').value = background.id;
          document.getElementById('popup').classList.add('visible');
          document.getElementById('popup').classList.remove('hidden');
          price.innerText = background.cakes.toLocaleString("pt-BR");

          bgTitle.innerText = background.name;
          if (background.description && background.collection) {
            bgDescription.innerText = `${background.description} \n\nColeção: ${background.collection}`;
          } else {
            bgDescription.innerText = "";
          }

          const userCakes = user.cakes;
          if (
            userData.userProfile.backgroundList.includes(background.id)
            || userData.userProfile.decorationList.includes(background.id)
            || userData.userProfile.layoutList.includes(background.id)
          ) {
            saveButton.disabled = true;
            saveButton.classList.add('disabled');
            saveButton.innerText = 'Comprado';
          } else {
            saveButton.disabled = userCakes < background.cakes;
            saveButton.classList.toggle('disabled', saveButton.disabled);
            saveButton.innerText = saveButton.disabled ? 'Insuficiente' : 'Comprar';
          }

          preloadImage(imageUrl).then((loadedUrl) => {
            popupImg.src = loadedUrl;
          });
        }

        function hidePopup() {
          const popup = document.getElementById('popup');
          popup.classList.remove('visible');

          setTimeout(() => {
            popup.classList.add('hidden');
          }, 300);
        }

        document.getElementById('purchaseForm').addEventListener('submit', function (event) {
          const backgroundId = document.getElementById('backgroundId').value;
          this.action = "/br/store/confirm/" + backgroundId;
        });
      </script>
</body>

</html>